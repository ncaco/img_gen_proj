# ============================================================
# Docker Compose용 환경 변수
# 사용: 이 파일을 .env 로 복사한 뒤 필요한 값만 설정
# ============================================================
# docker-compose.yml 이 이 .env 를 읽어서
# 백엔드/프론트엔드 컨테이너에 넘깁니다.
# ============================================================

# ---------- 1. 백엔드용 (Backend) ----------
# 디버그 모드 (true / false)
# BACKEND_DEBUG=false

# CORS 허용 오리진. 브라우저에서 접속하는 프론트 주소 (쉼표 구분)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT 시크릿. 운영 환경에서는 반드시 다른 값으로 설정
# JWT_SECRET=change-me-in-production-use-env

# OpenAI API 키 (Lore 분석 등 사용 시)
# OPENAI_API_KEY=


# ---------- 2. 프론트엔드용 (Frontend) ----------
# 브라우저에서 API 호출 시 사용할 백엔드 주소
# (Docker 기본: localhost:8000 / 다른 도메인·포트 사용 시 여기서 변경)
# NEXT_PUBLIC_API_BASE=http://localhost:8000
